# Conexao PostgreSQL local. Vazia habilita a fila em memoria.
# iniciar_tudo.bat carrega este arquivo quando salvo como backend/.env.
DATABASE_URL=

# Usuário único de desenvolvimento; todas as opções abaixo são necessárias.
# Gere o hash de sua senha e uma chave aleatória seguindo o README.
DEMO_USER_EMAIL=
DEMO_PASSWORD_HASH=
# Pelo menos 32 bytes; não reutilize a senha do usuário como chave.
JWT_SECRET_KEY=
