# Referência para a futura conexão PostgreSQL. Não há credenciais configuradas.
# Ausente ou vazia: a aplicação continua funcionando sem banco.
# Este arquivo não é carregado automaticamente; consulte o README.
DATABASE_URL=

# Usuário único de desenvolvimento; todas as opções abaixo são necessárias.
# Gere o hash de sua senha e uma chave aleatória seguindo o README.
DEMO_USER_EMAIL=
DEMO_PASSWORD_HASH=
# Pelo menos 32 bytes; não reutilize a senha do usuário como chave.
JWT_SECRET_KEY=
